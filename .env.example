# Copy to .env and fill in YOUR values. Never commit .env or paste real keys anywhere public.

# --- Database (Neon: postgresql+asyncpg://...?ssl=require) ---
DATABASE_URL_OVERRIDE=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# --- Redis / Celery broker (Upstash: rediss://default:TOKEN@HOST:6379) ---
REDIS_URL_OVERRIDE=rediss://default:PASSWORD@HOST:6379

# --- Local LLM (Ollama) ---
OLLAMA_URL=
LLM_MODEL=llama3:latest
AGENT_MODEL=llama3:latest

# --- Notebooks publish their ngrok URL here so the backend finds them ---
UPSTASH_REDIS_REST_URL=https://YOUR-NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN

IMAGE_API_URL=
WAN_API_URL=http://localhost:8188/v1/generate
CORS_ORIGINS=https://your-frontend.vercel.app

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================================================================
# VIDEO
# =====================================================================================================
VIDEO_MODE=t2v                 # default only; each project picks its own
VIDEO_T2V_RESOLUTION=960x544   # default only; each project picks Draft/Fast/Balanced/High
VIDEO_SERVER_TIMEOUT=3600
VIDEO_MAX_CLIP_SECONDS=10.0    # MUST match the notebook: LTX_MAX_FRAMES=241 ~10 s, 193 ~8 s, 121 ~5 s (Ovi ~5 s)
AMBIENCE_VOLUME=0.55

# How each scene is built is chosen per project in the app (Whole scene / Shot by shot / Reuse footage / Full film).
# SCENE_MODE / WHOLE_SCENE_MAX_SECONDS are only the defaults for projects that never chose.
SCENE_MODE=whole
WHOLE_SCENE_MAX_SECONDS=

# =====================================================================================================
# Conversations and complete spoken lines
# =====================================================================================================
# auto = camera chosen shot by shot (calm/tracking for talk, dynamic for action). Others: model | gentle | static
VIDEO_CAMERA_MOTION=auto
# Only used when nothing specific is happening in the shot. A situation in the scene (stuck in mud, hiding, sitting, swimming,
# climbing, lying hurt) or a specific action is always shown as written.
# walk = walk-and-talk (no bouncing/jumping/pacing); stay = stand and face each other; free = model decides
# Who talks TO whom decides the camera: people in a conversation are seen from the side (two-shot, then over-the-shoulder),
# eyes on each other, never into the lens. false = the old wording (the camera follows whoever speaks).
CONVERSATION_COVERAGE=true
CONVERSATION_STAGING=walk

AUDIO_MODE=model               # model = the video model speaks | voices = edge-tts
MODEL_VOICE_MAX_WORDS=13
MODEL_VOICE_WPS=2.1
SPEECH_COMPLETE_CHECK=true
SPEECH_RETRY_EXTRA_SECONDS=1.5
SPEECH_MAX_RETRIES=2
# A clip that took longer than this many seconds to render is kept, never re-rendered or split because its last word
# seems cut off (a T4 needs 25-40 min per clip). 0 = always allow retries.
SPEECH_RETRY_MAX_RENDER_SECONDS=900
SPEECH_TAIL_MARGIN_DB=14.0
VIDEO_AUDIO_DRIVEN=false       # true only for MultiTalk / InfiniteTalk / Hunyuan Avatar (AUDIO_MODE=voices, image-first)
